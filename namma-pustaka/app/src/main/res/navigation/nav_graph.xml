<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/onboardingFragment">

    <!-- Onboarding -->
    <fragment
        android:id="@+id/onboardingFragment"
        android:name="com.nammapustaka.ui.onboarding.OnboardingFragment"
        android:label="Onboarding"
        tools:layout="@layout/fragment_onboarding_pager">
        <action
            android:id="@+id/action_onboarding_to_login"
            app:destination="@id/loginFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@id/onboardingFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Login -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.nammapustaka.ui.auth.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out" />
        <action
            android:id="@+id/action_login_to_home"
            app:destination="@id/homeFragment"
            app:enterAnim="@anim/slide_up_in"
            app:exitAnim="@anim/fade_out"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_login_to_teacher_dashboard"
            app:destination="@id/teacherDashboardFragment"
            app:enterAnim="@anim/slide_up_in"
            app:exitAnim="@anim/fade_out"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Register -->
    <fragment
        android:id="@+id/registerFragment"
        android:name="com.nammapustaka.ui.auth.RegisterFragment"
        android:label="Register"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_register_to_home"
            app:destination="@id/homeFragment"
            app:enterAnim="@anim/slide_up_in"
            app:exitAnim="@anim/fade_out"
            app:popUpTo="@id/registerFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Home -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.nammapustaka.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_book_detail"
            app:destination="@id/bookDetailFragment"
            app:enterAnim="@anim/shared_enter"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/shared_exit">
            <argument
                android:name="bookId"
                app:argType="string" />
        </action>
        <action
            android:id="@+id/action_home_to_catalog"
            app:destination="@id/bookCatalogFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left" />
        <action
            android:id="@+id/action_home_to_ai_chat"
            app:destination="@id/aiChatFragment"
            app:enterAnim="@anim/slide_up_in"
            app:exitAnim="@anim/fade_out" />
        <action
            android:id="@+id/action_home_to_qr_scanner"
            app:destination="@id/qrScannerFragment"
            app:enterAnim="@anim/slide_up_in"
            app:exitAnim="@anim/fade_out" />
    </fragment>

    <!-- Book Catalog -->
    <fragment
        android:id="@+id/bookCatalogFragment"
        android:name="com.nammapustaka.ui.catalog.CatalogFragment"
        android:label="Catalog"
        tools:layout="@layout/fragment_book_catalog">
        <action
            android:id="@+id/action_catalog_to_book_detail"
            app:destination="@id/bookDetailFragment"
            app:enterAnim="@anim/shared_enter"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/shared_exit">
            <argument
                android:name="bookId"
                app:argType="string" />
        </action>
    </fragment>

    <!-- Book Detail -->
    <fragment
        android:id="@+id/bookDetailFragment"
        android:name="com.nammapustaka.ui.bookdetail.BookDetailFragment"
        android:label="Book Details"
        tools:layout="@layout/fragment_book_detail">
        <argument
            android:name="bookId"
            app:argType="string" />
        <action
            android:id="@+id/action_book_detail_to_qr_scanner"
            app:destination="@id/qrScannerFragment"
            app:enterAnim="@anim/slide_up_in"
            app:exitAnim="@anim/fade_out" />
    </fragment>

    <!-- QR Scanner -->
    <fragment
        android:id="@+id/qrScannerFragment"
        android:name="com.nammapustaka.ui.qrscanner.QrScannerFragment"
        android:label="QR Scanner"
        tools:layout="@layout/fragment_qr_scanner" />

    <!-- AI Chat -->
    <fragment
        android:id="@+id/aiChatFragment"
        android:name="com.nammapustaka.ui.aichat.AiChatFragment"
        android:label="AI Librarian"
        tools:layout="@layout/fragment_ai_chat" />

    <!-- Leaderboard -->
    <fragment
        android:id="@+id/leaderboardFragment"
        android:name="com.nammapustaka.ui.leaderboard.LeaderboardFragment"
        android:label="Leaderboard"
        tools:layout="@layout/fragment_leaderboard" />

    <!-- Student Profile -->
    <fragment
        android:id="@+id/studentProfileFragment"
        android:name="com.nammapustaka.ui.profile.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_student_profile">
        <action
            android:id="@+id/action_profile_to_login"
            app:destination="@id/loginFragment"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Teacher Dashboard -->
    <fragment
        android:id="@+id/teacherDashboardFragment"
        android:name="com.nammapustaka.ui.teacher.TeacherDashboardFragment"
        android:label="Teacher Dashboard"
        tools:layout="@layout/fragment_teacher_dashboard">
        <action
            android:id="@+id/action_teacher_to_analytics"
            app:destination="@id/analyticsFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left" />
        <action
            android:id="@+id/action_teacher_to_add_book"
            app:destination="@id/addBookFragment"
            app:enterAnim="@anim/slide_up_in"
            app:exitAnim="@anim/fade_out" />
        <action
            android:id="@+id/action_teacher_to_students"
            app:destination="@id/leaderboardFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left" />
        <action
            android:id="@+id/action_teacher_to_overdue"
            app:destination="@id/bookCatalogFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left" />
        <action
            android:id="@+id/action_teacher_to_login"
            app:destination="@id/loginFragment"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Analytics -->
    <fragment
        android:id="@+id/analyticsFragment"
        android:name="com.nammapustaka.ui.analytics.AnalyticsFragment"
        android:label="Analytics"
        tools:layout="@layout/fragment_analytics" />

    <!-- Add Book Dialog (Teacher) -->
    <dialog
        android:id="@+id/addBookFragment"
        android:name="com.nammapustaka.ui.teacher.AddBookDialogFragment"
        android:label="Add Book" />

</navigation>
