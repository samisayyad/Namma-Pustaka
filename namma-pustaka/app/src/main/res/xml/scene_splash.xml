<?xml version="1.0" encoding="utf-8"?>
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:motion="http://schemas.android.com/apk/res-auto">

    <ConstraintSet android:id="@+id/start">
        <Constraint android:id="@+id/ivLogo"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:alpha="0"
            android:scaleX="0.3"
            android:scaleY="0.3"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintTop_toTopOf="parent"
            motion:layout_constraintBottom_toTopOf="@id/tvAppName" />
        <Constraint android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0"
            android:translationY="60dp"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintTop_toBottomOf="@id/ivLogo"
            motion:layout_constraintBottom_toTopOf="@id/tvTagline" />
        <Constraint android:id="@+id/tvTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0"
            android:translationY="40dp"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintTop_toBottomOf="@id/tvAppName"
            motion:layout_constraintBottom_toTopOf="@id/lottieLoading" />
        <Constraint android:id="@+id/tvTaglineKannada"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintBottom_toTopOf="@id/lottieLoading" />
        <Constraint android:id="@+id/lottieLoading"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:alpha="0"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_marginBottom="64dp" />
    </ConstraintSet>

    <ConstraintSet android:id="@+id/end">
        <Constraint android:id="@+id/ivLogo"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:alpha="1"
            android:scaleX="1"
            android:scaleY="1"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintTop_toTopOf="parent"
            motion:layout_constraintBottom_toTopOf="@id/tvAppName" />
        <Constraint android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="1"
            android:translationY="0dp"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintTop_toBottomOf="@id/ivLogo"
            motion:layout_constraintBottom_toTopOf="@id/tvTagline"
            motion:layout_marginTop="12dp" />
        <Constraint android:id="@+id/tvTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="1"
            android:translationY="0dp"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintTop_toBottomOf="@id/tvAppName"
            motion:layout_constraintBottom_toTopOf="@id/lottieLoading"
            motion:layout_marginTop="4dp" />
        <Constraint android:id="@+id/tvTaglineKannada"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="1"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintBottom_toTopOf="@id/lottieLoading"
            motion:layout_marginBottom="8dp" />
        <Constraint android:id="@+id/lottieLoading"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:alpha="1"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_marginBottom="64dp" />
    </ConstraintSet>

    <Transition
        motion:constraintSetStart="@id/start"
        motion:constraintSetEnd="@id/end"
        motion:duration="900"
        motion:motionInterpolator="easeInOut"
        motion:autoTransition="animateToEnd">

        <KeyFrameSet>
            <KeyAttribute
                motion:target="@id/ivLogo"
                motion:framePosition="0"
                android:alpha="0"
                android:scaleX="0.3"
                android:scaleY="0.3" />
            <KeyAttribute
                motion:target="@id/ivLogo"
                motion:framePosition="60"
                android:alpha="1"
                android:scaleX="1.1"
                android:scaleY="1.1" />
            <KeyAttribute
                motion:target="@id/ivLogo"
                motion:framePosition="100"
                android:scaleX="1.0"
                android:scaleY="1.0" />
            <KeyAttribute
                motion:target="@id/tvAppName"
                motion:framePosition="30"
                android:alpha="0" />
            <KeyAttribute
                motion:target="@id/tvAppName"
                motion:framePosition="80"
                android:alpha="1" />
            <KeyAttribute
                motion:target="@id/tvTagline"
                motion:framePosition="50"
                android:alpha="0" />
            <KeyAttribute
                motion:target="@id/tvTagline"
                motion:framePosition="100"
                android:alpha="1" />
        </KeyFrameSet>
    </Transition>

</MotionScene>
