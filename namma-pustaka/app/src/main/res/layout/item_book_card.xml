<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="140dp"
    android:layout_height="230dp"
    android:layout_marginHorizontal="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Book Cover -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="160dp">

            <ImageView
                android:id="@+id/ivBookCover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:transitionName="book_cover"
                android:background="@drawable/bg_book_cover_placeholder" />

            <!-- Availability badge -->
            <TextView
                android:id="@+id/tvAvailability"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:text="@string/available"
                android:textSize="9sp"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_available_badge"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp" />

            <!-- Favorite Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFavorite"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="8dp"
                app:icon="@drawable/ic_favorite_outline"
                app:iconSize="16dp"
                app:iconTint="#FFFFFF"
                app:backgroundTint="#66000000"
                app:cornerRadius="16dp"
                style="@style/Widget.Material3.Button.IconButton"
                android:padding="6dp" />

        </FrameLayout>

        <!-- Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/tvBookTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:transitionName="book_title"
                android:textSize="12sp"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="?attr/colorOnSurface"
                android:maxLines="2"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.2" />

            <TextView
                android:id="@+id/tvBookAuthor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:fontFamily="@font/poppins_regular"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="2dp" />

            <RatingBar
                android:id="@+id/ratingBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="?android:attr/ratingBarStyleSmall"
                android:numStars="5"
                android:rating="4.0"
                android:stepSize="0.5"
                android:isIndicator="true"
                android:layout_marginTop="4dp"
                android:transformPivotX="0dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
