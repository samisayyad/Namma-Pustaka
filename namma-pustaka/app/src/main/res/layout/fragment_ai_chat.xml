<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBackground">

    <!-- Gradient Header -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_gradient_primary"
        android:paddingTop="48dp"
        android:paddingBottom="20dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:icon="@drawable/ic_arrow_back"
                app:iconTint="#FFFFFF"
                app:backgroundTint="#22FFFFFF"
                app:cornerRadius="20dp"
                style="@style/Widget.Material3.Button.IconButton" />

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottieAiAvatar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                app:lottie_rawRes="@raw/anim_ai_avatar"
                app:lottie_autoPlay="true"
                app:lottie_loop="true" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_librarian"
                    android:textSize="18sp"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="#FFFFFF" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_online_dot" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Online • Powered by Gemini"
                        android:textSize="12sp"
                        android:fontFamily="@font/poppins_regular"
                        android:textColor="#CCE5DEFF"
                        android:layout_marginStart="6dp" />

                </LinearLayout>

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearChat"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:icon="@drawable/ic_delete_outline"
                app:iconTint="#FFFFFF"
                app:backgroundTint="#22FFFFFF"
                app:cornerRadius="20dp"
                style="@style/Widget.Material3.Button.IconButton" />

        </LinearLayout>

        <!-- Suggestion Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSuggest1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recommend a book"
                    android:textColor="#5B4FCF"
                    app:chipBackgroundColor="#FFFFFF"
                    android:fontFamily="@font/poppins_regular" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSuggest2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Summarize this book"
                    android:textColor="#5B4FCF"
                    app:chipBackgroundColor="#FFFFFF"
                    android:fontFamily="@font/poppins_regular"
                    android:layout_marginStart="8dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSuggest3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Science books for Class 8"
                    android:textColor="#5B4FCF"
                    app:chipBackgroundColor="#FFFFFF"
                    android:fontFamily="@font/poppins_regular"
                    android:layout_marginStart="8dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSuggest4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ಕನ್ನಡ ಪುಸ್ತಕಗಳು"
                    android:textColor="#5B4FCF"
                    app:chipBackgroundColor="#FFFFFF"
                    android:fontFamily="@font/poppins_regular"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp" />

            </LinearLayout>

        </HorizontalScrollView>

    </LinearLayout>

    <!-- Chat Messages -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChat"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="16dp"
        android:clipToPadding="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:stackFromEnd="true"
        app:reverseLayout="false"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toTopOf="@id/inputLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Typing Indicator -->
    <LinearLayout
        android:id="@+id/typingIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/inputLayout"
        app:layout_constraintStart_toStartOf="parent">

        <com.airbnb.lottie.LottieAnimationView
            android:layout_width="48dp"
            android:layout_height="32dp"
            app:lottie_rawRes="@raw/anim_typing_dots"
            app:lottie_autoPlay="true"
            app:lottie_loop="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ai_thinking"
            android:textSize="13sp"
            android:fontFamily="@font/poppins_regular"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginStart="4dp" />

    </LinearLayout>

    <!-- Input Bar -->
    <LinearLayout
        android:id="@+id/inputLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/colorSurface"
        android:padding="12dp"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/type_message"
            app:boxCornerRadiusTopStart="24dp"
            app:boxCornerRadiusTopEnd="24dp"
            app:boxCornerRadiusBottomStart="24dp"
            app:boxCornerRadiusBottomEnd="24dp"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
            app:endIconDrawable="@drawable/ic_mic"
            app:endIconMode="custom"
            app:endIconTint="?attr/colorPrimary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:maxLines="4"
                android:fontFamily="@font/poppins_regular"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabSend"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:contentDescription="Send"
            app:srcCompat="@drawable/ic_send"
            app:fabSize="mini"
            app:backgroundTint="?attr/colorPrimary"
            app:tint="?attr/colorOnPrimary" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
